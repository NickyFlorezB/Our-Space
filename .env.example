# Copy to .env, replace the placeholders, and restrict file access with chmod 600.
DB_NAME=ourspace
DB_USER=espacio
DB_PASSWORD=replace-with-the-current-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Preserve the existing development database volume when moving to this compose file.
DB_VOLUME_NAME=our-space_pgdata
IMAGE_STORAGE_HOST_PATH=/home/nicky/.ourspace/images
APP_UID=1000
APP_GID=1000

# Same-origin requests do not need CORS; set the actual Tailscale Serve URL if needed.
FRONTEND_ORIGINS=https://our-space.example.ts.net
